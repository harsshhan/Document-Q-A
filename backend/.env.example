# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Application ---
APP_ENV=development

# --- Gemini (embeddings + answer generation) ---
# Required. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=512

# Embedding vector size. Changing this requires re-embedding all chunks.
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=20

# --- Database (PostgreSQL + pgvector) ---
# Local default matches docker-compose.yml. Production must override this.
# Switching to Amazon RDS is a change of this one value, for example:
#   DATABASE_URL=postgresql+asyncpg://<user>:<password>@<instance>.<id>.<region>.rds.amazonaws.com:5432/document_qa?ssl=require
# asyncpg accepts `ssl=require` (TLS, no CA verification) and has no `sslmode`
# argument, so do not use the libpq-style name in this URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_qa
DATABASE_ECHO=false

# --- Authentication ---
# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a dedicated secret, at least 32 characters, and never GEMINI_API_KEY.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# --- Ingestion / retrieval ---
MAX_UPLOAD_SIZE_BYTES=10485760
RAG_DEFAULT_TOP_K=3
RAG_MAX_TOP_K=10
RAG_MIN_SIMILARITY=0.5

# --- Demo seed (optional) ---
# Overrides the demo user's password when running scripts/seed_demo_user.py.
DEMO_USER_PASSWORD=DemoPass123!

# --- Amazon S3 (private storage for the uploaded PDFs) ---
# Required for uploads: without a bucket name the API rejects them with 503.
# The bucket must be private; the app never sets an ACL or returns public URLs.
S3_BUCKET_NAME=
# The region the bucket lives in (e.g. eu-west-1). Required when a bucket is set.
AWS_REGION=

# Static credentials are OPTIONAL and ignored when empty: boto3 then uses its
# normal provider chain (environment, ~/.aws/credentials, IAM role), which is the
# preferred setup on EC2/ECS/Lambda. Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Tests (optional) ---
# Dedicated PostgreSQL database used by the integration tests.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_qa_test